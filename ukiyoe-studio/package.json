{
  "name": "ukiyoe-studio",
  "productName": "Ukiyo-e Studio",
  "version": "1.0.1",
  "description": "Офлайн-студия фильмов в стиле укиё-э",
  "main": "main.js",
  "license": "SEE LICENSE IN NOTICE.md",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never"
  },
  "dependencies": {
    "mp4-muxer": "5.2.2"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.0.12"
  },
  "author": "Ukiyo-e Studio",
  "build": {
    "appId": "local.ukiyoe.studio",
    "productName": "Ukiyo-e Studio",
    "copyright": "Некоммерческое использование",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png",
      "LICENSE*",
      "NOTICE.md"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "artifactName": "UkiyoeStudio-${version}-linux.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.graphics-design",
      "artifactName": "UkiyoeStudio-${version}-mac.${ext}"
    },
    "publish": null,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ukiyo-e Studio",
      "artifactName": "UkiyoeStudio-Setup-${version}.${ext}",
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049",
      "uninstallDisplayName": "Ukiyo-e Studio",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "UkiyoeStudio-Portable-${version}.${ext}"
    }
  }
}